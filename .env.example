# Copy this file to .env and replace EVERY "CHANGE_ME".
#   cp .env.example .env
# .env is git-ignored. NEVER commit real values.
#
# Generate strong values with OpenSSL, e.g.:
#   openssl rand -hex 32        (JWT_SECRET, BACKUP_KEY, DB password)
#   openssl rand -base64 32     (FIELD_ENCRYPTION_KEY; Saleha confirms the format)

# --- Database (used by the db container) ---
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=CHANGE_ME

# --- Backend database connection ---
# The host MUST stay "db" (the Compose service). Never point this at a shared
# or remote database. Use the same user, password and database name as above.
# If the password has special characters (@ : / %), URL-encode them,
# or simply use a hex password.
DATABASE_URL=postgresql+psycopg2://CHANGE_ME:CHANGE_ME@db:5432/CHANGE_ME

# --- Authentication ---
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Encryption and backups ---
FIELD_ENCRYPTION_KEY=CHANGE_ME
BACKUP_KEY=CHANGE_ME

# --- HTTPS (nginx, ticket A-05) ---
# Host paths of the CA-issued server certificate and its private key. nginx
# mounts these two files read-only. They live in secrets/ (git-ignored).
# No certificate yet? ./scripts/dev_self_signed_cert.sh creates a TEMPORARY one
# at these same paths. Replace it with the CA-issued pair when it is ready.
TLS_CERT_PATH=./secrets/server.crt
TLS_KEY_PATH=./secrets/server.key
